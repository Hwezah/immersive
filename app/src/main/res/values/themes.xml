<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window behind Compose: the page colour, so there is no white flash at start. -->
    <style name="Theme.Immersive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
